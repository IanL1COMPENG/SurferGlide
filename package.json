{
  "name": "surfer-glide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An original tropical wakeboarding arcade game with room-code multiplayer.",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "verify:deploy": "tsx scripts/check-deploy.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "three": "^0.180.0",
    "tsx": "^4.20.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": "22.x"
  }
}
