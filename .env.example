# Public build-time endpoint for a separately hosted multiplayer server.
# Leave empty for local development or a single Node deployment.
# VITE_MULTIPLAYER_URL=wss://YOUR-SERVICE.onrender.com/ws
VITE_MULTIPLAYER_URL=

# Server environment only: comma-separated exact frontend origins, no paths.
# Set this in Render's Environment dashboard. Node does not auto-load .env.
# ALLOWED_ORIGINS=https://YOUR-PROJECT.vercel.app
ALLOWED_ORIGINS=
